uni_start_stream <00x>
  if_online_then <1>
  async_alert <info, "You may not auto-detect installed devices while\x7fyou are connected to America Online.">
uni_abort_stream
uni_sync_skip <1>
man_start_object <ind_group, "AOL Setup">
  mat_object_id <32-5574>
  mat_style_id <32-5574>
  mat_orientation <hff>
  mat_color_face <255, 251, 240>
  mat_bool_background_flood <yes>
  mat_position <center_center>
  mat_bool_resize_vertical <no>
  mat_bool_modal <yes>
  mat_bool_background_flood <yes>
  man_start_object <org_group, "">
    mat_orientation <vff>
    man_start_object <ornament, "">
      mat_art_id <1-1-15806>
      mat_bool_disabled <yes>
    man_end_object
  man_start_sibling <org_group, "">
    mat_orientation <vff>
    man_start_object <org_group, "">
      mat_orientation <vff>
      man_start_object <ornament, "">
        mat_size <30, 1>
        mat_font_id <arial>
        mat_font_size <14>
        mat_font_style <bold>
        man_append_data <"Searching for a Way for You to Connect...">
      man_start_sibling <org_group, "">
        mat_orientation <vff>
        mat_precise_width <440>
        mat_precise_height <2>
        mat_color_face <1, 1, 1>
        mat_bool_background_flood <yes>
        mat_bool_precise <yes>
      man_end_object
    man_start_sibling <view, "">
      rich_manage
      rich_set_static
      mat_size <50, 7, 4096>
      mat_bool_vertical_scroll <no>
      mat_bool_resize_vertical <no>
      mat_bool_resize_horizontal <no>
      mat_bool_exportable <no>
      man_append_data <"The software is searching for a modem or other connection device your computer will use to connect to the AOL service.  This will take just a few moments.  No changes are being made to your computer at this time.  The setup and installation will continue automatically after AOL has detected a modem or other connection device.\x7f\x7f<B>Please wait while we search for your modem or connection device...</B>">
    man_start_sibling <org_group, "">
      mat_orientation <vcc>
      man_start_object <ornament, "">
        mat_art_animation_rate <175>
        mat_art_animation_seq <7, 1, 6, 1, 5, 1, 4, 1, 3, 1, 2, 1, 1, 1, 0, 1>
        mat_bool_repeat_animation <yes>
        mat_art_id <1-1-27048>
        mat_bool_disabled <yes>
      man_start_sibling <trigger, "">
        mat_bool_default <yes>
        mat_bool_invisible <yes>
      man_start_sibling <org_group, "">
        mat_orientation <vlf>
        man_start_object <trigger, "Cancel">
          mat_title_width <6>
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_sis <arial, 8, normal>
          if_newuser_then <2>
          mat_bool_invisible <yes>
          uni_sync_skip <2>
          mat_bool_gradual_shadow <yes>
          mat_command_key <71x, 01x>
          act_replace_select_action
              <
              uni_start_stream
                uni_invoke_no_context <41-27653>
              uni_end_stream
              >
          man_end_object
        man_end_object
      man_end_object
    man_end_object
    man_update_display
    dice_enum_comm_devices
    man_update_display
    act_set_criterion <666>
    act_replace_action
        <
        uni_start_stream
          dice_cancel_enum_devices
        uni_end_stream
        >
      uni_wait_off
    uni_end_stream <00x>
