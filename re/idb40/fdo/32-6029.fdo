uni_start_stream <00x>
  man_close_update
  dice_access_search_form
uni_abort_stream
man_start_object <ind_group, "\x01\x04AOL Setup">
  mat_object_id <32-6029>
  mat_style_id <32-6029>
  mat_orientation <hff>
  mat_color_face <255, 251, 240>
  mat_bool_background_flood <yes>
  mat_position <center_center>
  mat_bool_resize_vertical <no>
  mat_bool_modal <yes>
  mat_bool_background_flood <yes>
  man_start_object <ornament, "">
    mat_art_id <1-1-46515>
    mat_bool_disabled <yes>
  man_start_sibling <org_group, "">
    mat_orientation <vff>
    man_start_object <org_group, "">
      mat_orientation <vff>
      uni_start_typed_data <latin1>
      man_start_object <ornament, "Confirm Your Modem Connection">
        mat_size <30, 1, 128>
        mat_font_id <arial>
        mat_font_size <14>
        mat_font_style <bold>
      man_start_sibling <org_group, "">
        mat_orientation <vff>
        mat_precise_width <440>
        mat_precise_height <2>
        mat_color_face <1, 1, 1>
        mat_bool_background_flood <yes>
        mat_bool_precise <yes>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <vff>
      man_start_object <view, "">
        rich_manage
        rich_set_static
        mat_size <45, 3>
        mat_bool_vertical_scroll <no>
        mat_bool_resize_vertical <no>
        mat_bool_resize_horizontal <no>
        mat_bool_exportable <no>
        man_append_data <"Here is the result of the search.">
      man_start_sibling <org_group, "">
        mat_orientation <hlf>
        man_start_object <ornament, "Connection:">
          mat_size <10, 1, 16>
        man_start_sibling <ornament, "">
          mat_size <45, 2, 512>
          mat_relative_tag <1>
          mat_font_style <bold>
        man_start_sibling <ornament, "">
          mat_size <5, 1, 256>
          mat_relative_tag <3>
          mat_bool_invisible <yes>
        man_end_object
      man_start_sibling <view, "">
        rich_manage
        rich_set_static
        mat_size <45, 4, 256>
        mat_bool_vertical_scroll <no>
        mat_bool_resize_vertical <no>
        mat_bool_resize_horizontal <no>
        mat_bool_exportable <no>
        uni_next_atom_typed <ascii>
        man_append_data <" \x7fIf the software didn't correctly identify your modem, click <B>Change Modem</B>.  To continue, please click <B>Next</B>.">
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "">
        mat_trigger_style <plain_picture>
        man_obj_stack_pop <0>
        if_last_return_false_then <1>
        mat_bool_hidden <yes>
        uni_sync_skip <1>
        mat_art_id <1-1-31171>
        act_replace_select_action
            <
            uni_start_stream
              man_obj_stack_pop <1>
              uni_save_result
              if_last_return_true_then <1>
              man_close_update
              uni_get_result
              uni_use_last_atom_value <uni_invoke_no_context>
              uni_sync_skip <1>
            uni_end_stream
            >
        man_start_sibling <org_group, "">
          mat_orientation <hcc>
          man_start_object <trigger, "Change Modem">
            mat_title_width <13>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_sis <arial, 8, normal>
            act_replace_select_action
                <
                uni_start_stream
                  dice_set_context_device <1>
                  dice_send_message <12>
                  dice_end_context
                uni_end_stream
                >
            man_start_sibling <trigger, "Cancel">
              mat_title_width <6>
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_sis <arial, 8, normal>
              act_replace_select_action
                  <
                  uni_start_stream
                    uni_invoke_no_context <41-27653>
                  uni_end_stream
                  >
              man_start_sibling <trigger, "Help">
                mat_title_width <6>
                mat_color_face <0, 109, 170>
                mat_color_text <253, 253, 253>
                mat_trigger_style <place>
                mat_font_sis <arial, 8, normal>
                mat_bool_invisible <yes>
                act_replace_select_action
                    <
                    uni_start_stream
                      uni_next_atom_typed <ascii>
                      async_exec_context_help <73x, 65x, 74x, 75x, 70x>
                    uni_end_stream
                    >
                man_end_object
              man_start_sibling <trigger, "">
                mat_trigger_style <plain_picture>
                if_newuser_then <2, 3>
                mat_art_id <1-3-398>
                uni_sync_skip <2>
                mat_art_id <1-1-14785>
                uni_sync_skip <3>
                act_replace_select_action
                    <
                    uni_start_stream
                      man_obj_stack_push
                      man_close_update
                      dice_access_search_form
                    uni_end_stream
                    >
                man_end_object
              man_end_object
            man_end_object
            man_update_display
            act_set_criterion <gain_focus>
            act_replace_action
                <
                uni_start_stream
                  idb_set_context <20-3-31>
                  idb_atr_offset <0>
                  idb_atr_length <256>
                  man_set_context_relative <3>
                  idb_get_data
                  uni_save_result
                  uni_use_last_atom_string <man_replace_data>
                  man_change_context_relative <1>
                  man_replace_data <"  ">
                  uni_get_result
                  uni_use_last_atom_string <man_append_data>
                  uni_next_atom_typed <ascii>
                  man_append_data <".">
                  idb_end_context
                  man_update_display
                uni_end_stream
                >
              act_do_action <gain_focus>
              uni_wait_off
              uni_end_typed_data
              uni_wait_off
            uni_end_stream <00x>
