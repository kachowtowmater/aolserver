uni_start_stream <00x>
  man_start_object <ind_group, "AOL Setup">
    mat_object_id <41-22188>
    mat_style_id <41-22188>
    mat_orientation <hft>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_art_id <1-1-15806>
      mat_bool_disabled <yes>
    man_start_sibling <org_group, "">
      mat_orientation <vff>
      man_start_object <org_group, "">
        mat_orientation <vff>
        man_start_object <ornament, "">
          mat_size <27, 1, 128>
          mat_font_id <arial>
          mat_font_size <14>
          mat_font_style <bold>
          man_append_data <"Getting AOL Access Phone Numbers...">
        man_start_sibling <org_group, "">
          mat_orientation <vff>
          mat_precise_width <360>
          mat_precise_height <2>
          mat_color_face <1, 1, 1>
          mat_bool_background_flood <yes>
          mat_bool_precise <yes>
        man_end_object
      man_start_sibling <ornament, "">
        mat_size <10, 1, 5>
      man_start_sibling <ornament, "">
        mat_size <45, 3>
        man_append_data <"Please wait while we get a list of AOL access phone numbers for the area you specified.  This may take a few moments.  Thanks for your patience!">
      man_start_sibling <org_group, "">
        mat_orientation <vcc>
        man_start_object <ornament, "">
          mat_art_animation_rate <175>
          mat_art_animation_seq <7, 1, 6, 1, 5, 1, 4, 1, 3, 1, 2, 1, 1, 1, 0, 1>
          mat_bool_repeat_animation <yes>
          mat_art_id <1-1-27048>
          mat_bool_disabled <yes>
        man_start_sibling <trigger, "">
          mat_bool_default <yes>
          mat_bool_invisible <yes>
          act_replace_select_action
              <
              uni_start_stream <00x>
                man_close_update
              uni_end_stream <00x>
              >
          man_end_object
        man_end_object
      man_end_object
      man_update_display
      uni_wait_off
    uni_end_stream <00x>
