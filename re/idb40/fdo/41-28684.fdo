uni_start_stream <00x>
  man_preset_gid <41-13415>
  if_last_return_true_then <1>
  man_end_context
  idb_delete_obj <20-0-142>
  idb_delete_obj <41-28684>
uni_abort_stream
uni_sync_skip <1>
act_set_newuser_flag <01x>
man_start_object <ind_group, "AOL Setup">
  mat_object_id <41-28684>
  mat_style_id <41-28684>
  mat_orientation <hff>
  mat_color_face <255, 251, 240>
  mat_bool_background_flood <yes>
  mat_position <center_center>
  mat_bool_resize_vertical <no>
  mat_bool_modal <yes>
  man_start_object <ornament, "">
    mat_art_id <1-1-46515>
    mat_bool_disabled <yes>
  man_start_sibling <org_group, "">
    mat_orientation <vff>
    man_start_object <org_group, "">
      mat_orientation <vlc>
      man_start_object <ornament, "Update Modem Settings">
        mat_size <25, 1, 128>
        mat_font_id <arial>
        mat_font_size <14>
        mat_font_style <bold>
      man_start_sibling <org_group, "">
        mat_orientation <vff>
        mat_precise_width <440>
        mat_precise_height <2>
        mat_color_face <1, 1, 1>
        mat_bool_background_flood <yes>
        mat_bool_precise <yes>
      man_end_object
    man_start_sibling <ornament, "">
      mat_size <50, 4>
      man_append_data <"You may improve the reliability of your connection to the AOL service by switching from your current, generic, modem setting to one specifically designed for your modem.  What do you want to do?">
    man_start_sibling <sss_list, "">
      mat_orientation <vff>
      mat_relative_tag <1>
      man_start_object <trigger, "Automatically set up your modem (recommended).">
        mat_bool_default_send <no>
        mat_value <1>
      man_start_sibling <trigger, "Keep your old modem settings.">
        mat_bool_default_send <no>
      man_end_object
    man_start_sibling <view, "">
      rich_manage
      rich_set_static
      mat_size <45, 1, 512>
      mat_bool_vertical_scroll <no>
      mat_bool_resize_vertical <no>
      mat_bool_resize_horizontal <no>
      mat_bool_exportable <no>
      man_append_data <"Please choose a selection, then click <B>NEXT</B>.">
    man_start_sibling <org_group, "">
      mat_orientation <hrc>
      man_start_object <trigger, "">
        mat_trigger_style <plain_picture>
        if_newuser_then <2, 3>
        mat_art_id <1-3-398>
        uni_sync_skip <2>
        mat_art_id <1-1-14785>
        uni_sync_skip <3>
        mat_bool_default <yes>
        mat_command_key <99x, 00x>
        act_replace_select_action
            <
            uni_start_stream
              de_start_extraction <0>
              man_set_context_relative <1>
              de_get_data_value
              var_number_set_from_atom <B>
              man_end_context
              de_end_extraction
              if_numb_eq_one_then <1, 2>
              act_do_action <250>
              uni_sync_skip <1>
              act_do_action <251>
              uni_sync_skip <2>
              act_set_newuser_flag <00x>
              man_close_update
            uni_end_stream
            >
        man_end_object
      man_end_object
    man_end_object
    man_update_display
    act_set_criterion <250>
    act_replace_action
        <
        uni_start_stream
          morg_obj_set_context <"$Connectivity\\Devices">
          morg_obj_destroy_children
          morg_obj_end_context
          idb_exists <20-0-142>
          if_last_return_true_then <1>
          idb_delete_obj <20-0-142>
          uni_sync_skip <1>
          idb_start_obj
          idb_atr_globalid <20-0-142>
          idb_atr_length <128>
          var_string_set <A,"UPG">
          uni_use_last_atom_string <idb_append_data>
          idb_end_obj
          if_online_then <2>
        uni_abort_stream
        uni_sync_skip <2>
        man_preset_gid <32-221>
        if_last_return_true_then <3>
        mat_bool_invisible <yes>
        man_update_display
        man_end_context
        uni_sync_skip <3>
        man_obj_stack_pop <2>
        man_obj_stack_push
        uni_invoke_no_context <32-5574>
      uni_end_stream
      >
    act_set_criterion <251>
    act_replace_action
        <
        uni_start_stream
          morg_obj_set_context <"$Connectivity\\Devices">
          morg_obj_count_children
          var_number_set_from_atom <A>
          morg_obj_end_context
          if_numa_false_then <2>
          uni_invoke_no_context <41-13415>
          uni_sync_skip <2>
          idb_delete_obj <20-0-142>
          idb_delete_obj <41-28684>
          idb_delete_obj <41-28686>
          man_preset_gid <32-221>
          if_last_return_true_then <4, 5>
          mat_bool_invisible <no>
          man_end_context
          man_update_display
          uni_sync_skip <4>
          if_offline_then <5>
          uni_invoke_no_context <32-221>
          uni_sync_skip <5>
        uni_end_stream
        >
      uni_wait_off
    uni_end_stream <00x>
