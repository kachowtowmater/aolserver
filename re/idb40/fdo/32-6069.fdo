uni_start_stream <00x>
  man_start_object <ind_group, "">
    mat_object_id <32-6069>
    mat_style_id <32-6069>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_size <23, 4>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"\x7fCompressing attached files now,\x7f                  Please wait.">
    man_end_object
    man_update_display
    uni_wait_off
  uni_end_stream <00x>
