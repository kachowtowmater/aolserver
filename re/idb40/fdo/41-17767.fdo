uni_start_stream <00x>
  man_start_object <ind_group, "Client Request Area">
    mat_object_id <41-17767>
    mat_style_id <41-17767>
    mat_orientation <vlf>
    mat_position <center_center>
    mat_bool_invisible <yes>
    man_start_object <edit_view, "Sub-Function">
      mat_size <20, 1>
      mat_relative_tag <1>
      mat_bool_writeable <yes>
      man_append_data <"ClientRequestArea">
    man_start_sibling <edit_view, "Country Code">
      mat_size <20, 1>
      mat_relative_tag <2>
      mat_bool_writeable <yes>
    man_start_sibling <edit_view, "Area Code">
      mat_size <20, 1>
      mat_relative_tag <3>
      mat_bool_writeable <yes>
    man_start_sibling <edit_view, "Time-Stamp of last update">
      mat_size <20, 1>
      mat_relative_tag <4>
      mat_bool_writeable <yes>
    man_start_sibling <edit_view, "fEntire State">
      mat_size <20, 1>
      mat_relative_tag <5>
      mat_bool_writeable <yes>
    man_start_sibling <edit_view, "fDirect Request">
      mat_size <20, 1>
      mat_relative_tag <7>
      mat_bool_writeable <yes>
    man_start_sibling <trigger, "Send Request">
      mat_relative_tag <6>
      mat_bool_default <yes>
      act_replace_select_action
          <
          uni_start_stream_wait_on <00x>
            uni_wait_on
            sm_check_domain
            de_validate <display_msg | terminate>
            de_start_extraction
            buf_set_token <"AN">
            de_get_data
            de_end_extraction
            buf_close_buffer
            man_close_update
          uni_end_stream <00x>
          >
      man_end_object
      man_update_display
      uni_wait_off
    uni_end_stream <00x>
