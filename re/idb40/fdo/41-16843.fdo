uni_start_stream <00x>
  man_start_object <ind_group, "Important:  Networks No Longer Supported">
    mat_object_id <41-16843>
    mat_style_id <41-16843>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_background_flood <yes>
    man_start_object <org_group, "">
      mat_orientation <hff>
      man_start_object <ornament, "">
        mat_art_id <1-1-22358>
        mat_bool_disabled <yes>
      man_start_sibling <org_group, "">
        mat_orientation <vff>
        man_start_object <view, "">
          rich_manage
          rich_set_static
          mat_size <40, 9>
          mat_bool_vertical_scroll <no>
          mat_bool_resize_vertical <no>
          mat_bool_resize_horizontal <no>
          mat_bool_exportable <no>
          man_append_data <"<B>You can no longer connect to the AOL service through the Tymnet or Datapac network.</B>  Access phone numbers previously set up to work with one of these networks were not transferred during your AOL upgrade.\x7f\x7fTo get additional access phone numbers, click on Setup, then click Add Number.">
        man_end_object
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hcc>
      man_start_object <trigger, "OK">
        mat_title_width <6>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_sis <arial, 8, normal>
        mat_bool_default <yes>
        act_replace_select_action
            <
            uni_start_stream <00x>
              man_close_update
            uni_end_stream <00x>
            >
        man_end_object
      man_end_object
      man_update_display
      uni_wait_off
    uni_end_stream <00x>
