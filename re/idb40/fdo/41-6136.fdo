uni_start_stream <00x>
  man_start_object <ind_group, "Edit Group">
    mat_object_id <41-6136>
    mat_style_id <41-6136>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_width <272>
    man_start_object <org_group, "">
      mat_orientation <vcc>
      man_start_object <edit_view, "Group Name:">
        mat_frame_style <pop_in>
        mat_relative_tag <1>
        mat_title_pos <above | top_or_left>
        mat_height <1>
        mat_width <27>
        mat_validation <128>
        mat_field_script <any>
        mat_bool_writeable <yes>
      man_end_object
      man_start_object <edit_view, "Addresses:">
        mat_frame_style <pop_in>
        mat_relative_tag <2>
        mat_title_pos <above | top_or_left>
        mat_height <11>
        mat_width <27>
        mat_validation <128>
        mat_bool_writeable <yes>
      man_end_object
    man_end_object
    mat_position <center_center>
    mat_bool_background_flood <yes>
    man_start_object <org_group, "">
      mat_orientation <hcf>
      man_start_object <trigger, "">
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_title <"       OK        ">
        mat_horizontal_spacing <7>
        mat_bool_default <yes>
        mat_font_id <arial>
        mat_command_key <0dx, 01x>
        act_replace_select_action
            <
            uni_start_stream
              de_validate <display_msg>
              if_last_return_false_then <1>
              mip_action_command <2ax>
              uni_sync_skip <1>
            uni_end_stream
            >
        man_start_sibling <trigger, "">
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_size <8>
          mat_title <"     Cancel     ">
          mat_horizontal_spacing <7>
          mat_font_id <arial>
          act_replace_select_action
              <
              uni_start_stream <00x>
                man_close_update
              uni_end_stream <00x>
              >
          man_start_sibling <trigger, "">
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_title <"      Help      ">
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream_wait_on
                  async_exec_context_help <41x, 64x, 64x, 72x, 65x, 73x, 73x, 20x, 42x, 6fx, 6fx, 6bx>
                uni_wait_off_end_stream
                >
            man_end_object
          man_end_object
          man_place_cursor <1>
          man_update_display
          uni_wait_off
        uni_end_stream <00x>
