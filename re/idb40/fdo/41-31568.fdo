uni_start_stream <00x>
  man_start_object <ind_group, "AOL Setup">
    mat_object_id <41-31568>
    mat_style_id <41-31568>
    mat_orientation <hff>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    man_start_object <ornament, "">
      mat_art_id <1-1-46515>
      mat_bool_disabled <yes>
    man_start_sibling <org_group, "">
      mat_orientation <vff>
      man_start_object <org_group, "">
        mat_orientation <vlc>
        man_start_object <ornament, "Unable to Identify Area Code or Country">
          mat_size <30, 1, 128>
          mat_font_id <arial>
          mat_font_size <14>
          mat_font_style <bold>
        man_start_sibling <org_group, "">
          mat_orientation <hff>
          mat_precise_width <440>
          mat_precise_height <2>
          mat_color_face <1, 1, 1>
          mat_bool_background_flood <yes>
          mat_bool_precise <yes>
        man_end_object
      man_start_sibling <view, "">
        rich_manage
        rich_set_static
        mat_size <45, 6, 2048>
        mat_bool_vertical_scroll <no>
        mat_bool_resize_vertical <no>
        mat_bool_resize_horizontal <no>
        mat_bool_exportable <no>
        man_append_data <" \x7fWe were unable to identify the area code for the country you provided.  Please select another area code.  If you feel you may have mistyped your area code, retype it below to try the search again.  When you have typed an area code in the box below, click <B>OK</B> to continue.\x7f">
      man_start_sibling <org_group, "">
        mat_orientation <hcc>
        man_start_object <ornament, "Area Code:">
          mat_size <8, 1, 20>
          mat_relative_tag <2>
          mat_font_style <bold>
        man_start_sibling <edit_view, "">
          mat_size <3, 1, 3>
          mat_relative_tag <3>
          mat_bool_writeable <yes>
        man_end_object
        man_set_context_relative <3>
        mat_validation <129>
        man_end_context
        man_start_object <ornament, "(Example: 703)">
          mat_size <12, 1, 40>
          mat_relative_tag <4>
        man_end_object
      man_start_sibling <view, "">
        rich_manage
        rich_set_static
        mat_size <45, 2, 2048>
        mat_bool_vertical_scroll <no>
        mat_bool_resize_vertical <no>
        mat_bool_resize_horizontal <no>
        mat_bool_exportable <no>
        man_append_data <"If you'll be connecting the the AOL service from outside the U.S., then please select your country from the drop-down Country listbox below and click <B>OK</B>.">
      man_start_sibling <org_group, "">
        mat_orientation <vcc>
        man_start_object <org_group, "">
          mat_orientation <hct>
          man_start_object <ornament, "Country:">
            mat_size <6, 1, 10>
            mat_font_style <bold>
          man_start_sibling <dss_list, "">
            mat_orientation <vff>
            mat_size <18, 1>
            mat_relative_tag <1>
            mat_title_pos <left | top_or_left>
            act_replace_select_action
                <
                uni_start_stream
                  dice_access_action <2>
                  act_do_action <225>
                  man_update_display
                uni_end_stream
                >
            man_start_sibling <ornament, "(click to view)">
              mat_size <14, 1, 40>
            man_end_object
          man_start_sibling <ornament, "">
            mat_size <5, 1, 4>
          man_end_object
        man_start_sibling <org_group, "">
          mat_orientation <hcc>
          man_start_object <trigger, "OK">
            mat_title_width <8>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_sis <arial, 8, normal>
            mat_bool_default <yes>
            act_replace_select_action
                <
                uni_start_stream
                  de_validate <0>
                  if_last_return_true_then <2, 3>
                  async_alert <info, "Please enter an area code so that our software can find access phone numbers near you.">
                  man_place_cursor <3>
                  man_update_display
                  uni_sync_skip <2>
                  dice_access_action <3>
                  uni_sync_skip <3>
                uni_end_stream
                >
            man_start_sibling <trigger, "">
              mat_title_width <5>
              mat_bool_hidden <yes>
            man_start_sibling <trigger, "Cancel">
              mat_title_width <8>
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_sis <arial, 8, normal>
              if_newuser_then <2>
              mat_bool_invisible <yes>
              uni_sync_skip <2>
              mat_command_key <71x, 01x>
              act_replace_select_action
                  <
                  uni_start_stream
                    uni_invoke_no_context <41-27653>
                  uni_end_stream
                  >
              man_end_object
            man_end_object
          man_end_object
          man_update_display
          act_set_criterion <666>
          act_replace_action
              <
              uni_start_stream
                dice_access_action <14>
              uni_end_stream
              >
            act_set_criterion <225>
            act_replace_action
                <
                uni_start_stream
                  man_set_context_relative <3>
                  man_get_attribute <mat_bool_invisible>
                  uni_save_result
                  man_change_context_relative <5>
                  uni_get_result
                  uni_use_last_atom_value <mat_bool_invisible>
                  man_end_context
                uni_end_stream
                >
              dice_access_action <1>
              act_do_action <225>
              man_set_context_relative <3>
              man_make_focus
              man_update_display
              man_end_context
              uni_wait_off
              uni_wait_off
            uni_end_stream <00x>
