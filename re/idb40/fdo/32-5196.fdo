uni_start_stream <00x>
  man_start_object <ind_group, "Display Art Record">
    mat_object_id <32-5196>
    mat_orientation <vcf>
    mat_position <center_center>
    man_start_object <ornament, "">
      mat_relative_tag <2>
      mat_art_id <1-0-1467>
      mat_bool_disabled <yes>
    man_start_sibling <edit_view, "Enter the art ID to display:">
      mat_size <30, 1>
      mat_relative_tag <1>
      mat_bool_vertical_scroll <no>
      mat_bool_resize_vertical <no>
      mat_bool_exportable <no>
      mat_bool_importable <no>
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "OK">
        mat_bool_default <yes>
        act_replace_select_action
            <
            uni_start_stream
              de_start_extraction <0>
              man_set_context_relative <1>
              de_get_data_pointer
              uni_use_last_atom_string <mt_string_to_gid>
              uni_save_result
              man_end_context
              uni_get_result
              uni_use_last_atom_value <idb_exists>
              if_last_return_false_then <1, 2>
              async_alert <info, "No such database record.">
              uni_sync_skip <1>
              man_set_context_relative <2>
              uni_get_result
              uni_use_last_atom_value <mat_art_id>
              man_update_display
              man_end_context
              uni_get_result
              var_number_set_from_atom <A>
              uni_sync_skip <2>
              de_end_extraction
            uni_end_stream
            >
        man_start_sibling <org_group, "">
          mat_orientation <hff>
          man_start_object <trigger, "REV">
            act_replace_select_action
                <
                uni_start_stream
                  if_numa_true_then <20>
                  var_number_decrement <A>
                  var_number_set <B, 232>
                  var_number_get <A>
                  uni_use_last_atom_value <idb_exists>
                  if_last_return_false_then <11>
                  uni_wait_on
                  uni_start_loop
                  var_number_decrement <B>
                  var_number_decrement <A>
                  var_number_get <A>
                  uni_use_last_atom_value <idb_exists>
                  if_last_return_false_then <11>
                  if_numb_true_then <20>
                  uni_end_loop
                  uni_sync_skip <11>
                  man_set_context_relative <2>
                  var_number_get <A>
                  uni_use_last_atom_value <mat_art_id>
                  man_end_context
                  man_set_context_relative <1>
                  var_number_get <A>
                  uni_use_last_atom_value <mt_gid_to_string>
                  uni_use_last_atom_string <man_replace_data>
                  man_end_context
                  man_update_display
                  uni_sync_skip <20>
                  uni_wait_off
                uni_end_stream
                >
            man_start_sibling <trigger, "FWD">
              act_replace_select_action
                  <
                  uni_start_stream
                    if_numa_true_then <21>
                    var_number_increment <A>
                    var_number_set <B, 232>
                    var_number_get <A>
                    uni_use_last_atom_value <idb_exists>
                    if_last_return_false_then <11>
                    uni_wait_on
                    uni_start_loop
                    var_number_decrement <B>
                    var_number_increment <A>
                    var_number_get <A>
                    uni_use_last_atom_value <idb_exists>
                    if_last_return_false_then <11>
                    if_numb_true_then <21>
                    uni_end_loop
                    uni_sync_skip <11>
                    man_set_context_relative <2>
                    var_number_get <A>
                    uni_use_last_atom_value <mat_art_id>
                    man_end_context
                    man_set_context_relative <1>
                    var_number_get <A>
                    uni_use_last_atom_value <mt_gid_to_string>
                    uni_use_last_atom_string <man_replace_data>
                    man_end_context
                    man_update_display
                    uni_sync_skip <21>
                    uni_wait_off
                  uni_end_stream
                  >
              man_end_object
            man_end_object
          man_end_object
          man_update_display
          uni_wait_off
        uni_end_stream <00x>
