uni_start_stream <00x>
  man_start_object <ind_group, "Graphics Viewing Preferences">
    mat_object_id <32-5270>
    mat_style_id <32-5270>
    mat_orientation <vff>
    mat_precise_width <417>
    mat_precise_height <265>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_precise <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_precise_x <10>
      mat_precise_y <10>
      mat_precise_width <389>
      mat_precise_height <73>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"While you are online AOL will save online art to your PC's hard drive, this saves time when you enter the area again as you already have the necessary online art. You can control how much art is stored on your PC by changing the number below. If you increase the disk space AOL will run faster but take more space on your hard drive.">
    man_start_sibling <org_group, "">
      mat_orientation <hlf>
      mat_precise_x <10>
      mat_precise_y <100>
      mat_precise_width <400>
      mat_precise_height <30>
      man_start_object <ornament, "">
        mat_precise_x <10>
        mat_precise_y <93>
        mat_precise_width <241>
        mat_precise_height <16>
        mat_font_style <bold>
        man_append_data <"Maximum disk space to use for online art: ">
      man_end_object
      man_start_object <select_range, "">
        mat_font_sis <arial, 9, bold>
        mat_precise_x <254>
        mat_precise_y <89>
        mat_relative_tag <12>
        mat_minimum <1>
        mat_maximum <1000>
        mat_increment <1>
      man_end_object
      man_start_object <ornament, "">
        mat_precise_x <320>
        mat_precise_y <93>
        mat_precise_width <81>
        mat_precise_height <16>
        mat_font_style <bold>
        man_append_data <"megabyte(s)">
      man_end_object
    man_start_sibling <sms_list, "">
      mat_orientation <hff>
      mat_precise_x <9>
      mat_precise_y <139>
      mat_precise_width <13>
      mat_precise_height <13>
      man_start_object <trigger, "Display image files on download">
        mat_precise_x <9>
        mat_precise_y <118>
        mat_relative_tag <1>
        mat_font_sis <arial, 9, bold>
        mat_bool_default_send <no>
      man_end_object
    man_start_sibling <sms_list, "">
      mat_orientation <hff>
      man_start_object <trigger, "Notify before opening mail containing pictures">
        mat_precise_x <9>
        mat_precise_y <143>
        mat_relative_tag <2>
        mat_font_sis <arial, 9, bold>
        mat_bool_default_send <no>
        mat_value <1>
      man_end_object
    man_start_sibling <sms_list, "">
      mat_orientation <hff>
      man_start_object <trigger, "Present resizing options when inserting pictures in e-mail">
        mat_precise_x <9>
        mat_precise_y <168>
        mat_relative_tag <3>
        mat_font_sis <arial, 9, bold>
        mat_bool_default_send <no>
        mat_value <1>
      man_end_object
    man_end_object
    man_start_object <ornament, "">
      mat_font_sis <arial, 9, bold>
      mat_precise_x <10>
      mat_precise_y <200>
      mat_font_id <arial>
      mat_font_size <9>
      mat_font_style <bold>
      man_append_data <"JPEG compression quality:">
    man_end_object
    man_start_object <select_range, "">
      mat_font_sis <arial, 9, bold>
      mat_precise_x <168>
      mat_precise_y <196>
      mat_relative_tag <7>
      mat_title_pos <left | center | 4>
      mat_minimum <1>
      mat_maximum <100>
    man_end_object
    man_start_object <org_group, "">
      mat_orientation <hff>
      mat_precise_x <10>
      mat_precise_y <200>
      mat_precise_width <400>
      mat_precise_height <30>
      man_start_object <trigger, "OK">
        mat_title_width <9>
        mat_precise_x <74>
        mat_precise_y <234>
        mat_precise_width <70>
        mat_precise_height <23>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_horizontal_spacing <7>
        mat_bool_default <yes>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream
              de_start_extraction
              man_set_context_relative <7>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-280>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              man_set_context_relative <1>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-267>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              man_set_context_relative <2>
              idb_start_obj <"b">
              idb_atr_globalid <20-255-21>
              de_get_data_value
              if_last_return_true_then <1, 2>
              idb_append_data <00x, 00x, 00x, 00x>
              uni_sync_skip <1>
              idb_append_data <00x, 00x, 00x, 01x>
              uni_sync_skip <2>
              idb_end_obj
              man_end_context
              man_set_context_relative <3>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-2>
              de_get_data_value
              if_last_return_true_then <3, 4>
              idb_append_data <00x, 00x, 00x, 00x>
              uni_sync_skip <3>
              idb_append_data <00x, 00x, 00x, 01x>
              uni_sync_skip <4>
              idb_end_obj
              man_end_context
              man_set_context_relative <12>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-206>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              de_end_extraction
              man_close
              man_update_display
            uni_end_stream
            >
        man_start_sibling <trigger, "Set Color Mode">
          mat_title_width <11>
          mat_precise_x <160>
          mat_precise_y <234>
          mat_precise_width <90>
          mat_precise_height <23>
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_size <8>
          mat_font_id <arial>
          act_replace_select_action
              <
              uni_start_stream
                uni_invoke_no_context <32-2589>
              uni_end_stream
              >
          man_start_sibling <trigger, "Cancel">
            mat_title_width <9>
            mat_precise_x <263>
            mat_precise_y <234>
            mat_precise_width <70>
            mat_precise_height <23>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream <00x>
                  man_close_update
                uni_end_stream <00x>
                >
            man_end_object
          man_end_object
          man_update_display
          man_set_context_relative <7>
          act_get_db_value <14x, 00x, 01x, 18x>
          uni_use_last_atom_value <mat_value>
          man_set_context_relative <1>
          act_get_db_value <14x, 00x, 01x, 0bx>
          uni_use_last_atom_value <mat_value>
          man_end_context
          man_set_context_relative <2>
          act_get_db_value <14x, ffx, 00x, 15x>
          if_last_return_true_then <1, 2>
          mat_value <0>
          uni_sync_skip <1>
          mat_value <1>
          uni_sync_skip <2>
          man_end_context
          man_set_context_relative <3>
          act_get_db_value <14x, 00x, 00x, 02x>
          if_last_return_true_then <1, 2>
          mat_value <0>
          uni_sync_skip <1>
          mat_value <1>
          uni_sync_skip <2>
          man_end_context
          man_set_context_relative <12>
          act_get_db_value <14x, 00x, 00x, cex>
          uni_save_result
          uni_use_last_atom_value <mat_value>
          uni_get_result
          if_last_return_false_then <31>
          mat_value <10>
          uni_sync_skip <31>
          man_end_context
          man_update_display
          uni_wait_off
        uni_end_stream <00x>
