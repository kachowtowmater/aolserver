uni_start_stream <00x>
  man_start_object <ind_group, "Personal Filing Cabinet Preferences">
    mat_object_id <32-4678>
    mat_style_id <32-4678>
    mat_orientation <vff>
    mat_precise_width <430>
    mat_precise_height <290>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_precise <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_precise_x <10>
      mat_precise_y <10>
      mat_precise_width <410>
      mat_precise_height <57>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"These settings control when you will be warned about your Personal Filing Cabinet's size or free space (fragmentation). If you find that you are seeing these warnings too often, you may want to change the settings. Selecting Reset will return them to the default values.">
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      mat_precise_y <80>
      mat_precise_width <430>
      mat_precise_height <25>
      man_start_object <ornament, "">
        mat_precise_x <11>
        mat_precise_y <81>
        mat_precise_width <273>
        mat_precise_height <16>
        mat_font_id <arial>
        mat_font_size <9>
        mat_font_style <bold>
        man_append_data <"Issue warning about the PFC if file size reaches ">
      man_end_object
      man_start_object <select_range, "">
        mat_relative_tag <12>
        mat_font_sis <arial, 9, bold>
        mat_precise_x <283>
        mat_precise_y <77>
        mat_precise_width <60>
        mat_precise_height <24>
        mat_minimum <1>
        mat_maximum <1000>
        mat_increment <1>
      man_end_object
      man_start_object <ornament, "">
        mat_precise_x <349>
        mat_precise_y <81>
        mat_precise_width <65>
        mat_precise_height <16>
        mat_font_id <arial>
        mat_font_size <9>
        mat_font_style <bold>
        man_append_data <"megabytes">
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      mat_precise_y <110>
      mat_precise_width <430>
      mat_precise_height <25>
      man_start_object <ornament, "">
        mat_precise_x <11>
        mat_precise_y <115>
        mat_precise_width <300>
        mat_precise_height <16>
        mat_font_id <arial>
        mat_font_size <9>
        mat_font_style <bold>
        man_append_data <"Issue warning about the PFC if free space reaches">
      man_end_object
      man_start_object <select_range, "">
        mat_relative_tag <13>
        mat_font_sis <arial, 9, bold>
        mat_precise_x <301>
        mat_precise_y <111>
        mat_precise_width <60>
        mat_precise_height <24>
        mat_minimum <1>
        mat_maximum <100>
        mat_increment <1>
      man_end_object
      man_start_object <ornament, "">
        mat_precise_x <365>
        mat_precise_y <115>
        mat_precise_width <49>
        mat_precise_height <16>
        mat_font_id <arial>
        mat_font_size <9>
        mat_font_style <bold>
        man_append_data <"percent">
      man_end_object
    man_start_sibling <ornament, "">
      mat_precise_x <10>
      mat_precise_y <155>
      mat_precise_width <410>
      mat_precise_height <29>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"These settings control warnings about deleting items in your Personal Filing Cabinet, Favorite Places, and Online Mailbox.">
    man_start_sibling <sms_list, "">
      mat_orientation <hff>
      man_start_object <trigger, "Confirm before deleting single items">
        mat_precise_x <16>
        mat_precise_y <199>
        mat_relative_tag <1>
        mat_font_sis <arial, 9, bold>
        mat_bool_default_send <no>
      man_end_object
    man_start_sibling <sms_list, "">
      mat_orientation <hff>
      man_start_object <trigger, "Confirm before deleting multiple items">
        mat_precise_x <16>
        mat_precise_y <224>
        mat_relative_tag <2>
        mat_font_sis <arial, 9, bold>
        mat_bool_default_send <no>
        mat_value <1>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hce>
      mat_precise_y <251>
      mat_precise_width <430>
      mat_precise_height <35>
      man_start_object <trigger, "OK">
        mat_title_width <9>
        mat_precise_x <90>
        mat_precise_y <257>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_bool_default <yes>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream
              de_start_extraction
              man_set_context_relative <1>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-91>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              man_set_context_relative <2>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-92>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              man_set_context_relative <12>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-291>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              man_set_context_relative <13>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-292>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              de_end_extraction
              man_close
              man_update_display
            uni_end_stream
            >
        man_start_sibling <trigger, "Reset">
          mat_title_width <9>
          mat_precise_x <175>
          mat_precise_y <257>
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_size <8>
          mat_font_id <arial>
          act_replace_select_action
              <
              uni_start_stream
                man_set_context_relative <12>
                mat_value <10>
                man_end_context
                man_set_context_relative <13>
                mat_value <35>
                man_end_context
                man_update_display
              uni_end_stream
              >
          man_start_sibling <trigger, "Cancel">
            mat_title_width <9>
            mat_precise_x <261>
            mat_precise_y <257>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream <00x>
                  man_close_update
                uni_end_stream <00x>
                >
            man_end_object
          man_end_object
          man_update_display
          man_set_context_relative <1>
          act_get_db_value <14x, 00x, 00x, 5bx>
          uni_use_last_atom_value <mat_value>
          man_end_context
          man_set_context_relative <2>
          act_get_db_value <14x, 00x, 00x, 5cx>
          uni_use_last_atom_value <mat_value>
          man_end_context
          man_set_context_relative <12>
          act_get_db_value <14x, 00x, 01x, 23x>
          uni_use_last_atom_value <mat_value>
          man_end_context
          man_set_context_relative <13>
          act_get_db_value <14x, 00x, 01x, 24x>
          uni_use_last_atom_value <mat_value>
          man_end_context
          man_update_display
          man_end_context
          uni_wait_off
        uni_end_stream <00x>
