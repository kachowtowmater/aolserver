          mat_relative_tag <7>
        man_end_object
      man_start_sibling <org_group, "">
        mat_orientation <hlc>
        man_start_object <ornament, "State:">
          mat_size <8, 1>
          mat_font_id <arial>
          mat_font_size <10>
          mat_font_style <bold>
        man_start_sibling <ornament, "">
          mat_size <12, 1, 128>
          mat_relative_tag <8>
        man_end_object
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hlc>
      man_start_object <ornament, "Country:">
        mat_size <7, 1>
        mat_font_id <arial>
        mat_font_size <10>
        mat_font_style <bold>
      man_start_sibling <ornament, "">
        mat_size <20, 1>
        mat_relative_tag <2>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "OK">
        mat_title_width <8>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_sis <arial, 8, normal>
        mat_context_help <"Click here to close this window">
        act_replace_select_action
            <
            uni_start_stream <00x>
              man_close_update
            uni_end_stream <00x>
            >
        man_start_sibling <trigger, "Surcharge Info">
          mat_title_width <15>
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_sis <arial, 8, normal>
          mat_context_help <"Click here to read detailed\x7finformation about surcharges.">
          act_replace_select_action
              <
              uni_start_stream <00x>
                man_preset_gid <41-20987>
                if_last_return_true_then <1, 2>
                man_make_focus
                man_update_display
                uni_sync_skip <1>
                uni_wait_on
                uni_invoke_no_context <41-20987>
                uni_sync_skip <2>
              uni_end_stream <00x>
              >
          man_end_object
        man_end_object
        man_update_display
        uni_wait_off
      uni_end_stream <00x>
