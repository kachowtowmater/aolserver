uni_start_stream <00x>
  man_start_object <ind_group, "Mail Waiting To Be Sent">
    mat_object_id <41-13876>
    mat_style_id <41-13876>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_size <40, 4>
      mat_font_size <8>
      mat_vertical_spacing <4>
      mat_font_id <arial>
      man_append_data <"You have mail waiting to be sent.  To send all mail in your Mail Waiting to be Sent Folder, click Send Now.  To see your outgoing mail, click Mail Folders.  To send the mail later, click Send Later.">
    man_start_sibling <sms_list, "">
      mat_orientation <hff>
      man_start_object <trigger, "Sign off when finished">
        mat_relative_tag <1>
        mat_font_size <8>
        mat_bool_invisible <yes>
        mat_bool_default_send <no>
        mat_font_id <arial>
        mat_font_size <9>
        mat_font_style <bold>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <sms_list, "">
        mat_orientation <hff>
        man_start_object <trigger, "Do not ask me again">
          mat_relative_tag <3>
          mat_bool_draw_focus <yes>
          mat_vertical_spacing <3>
          mat_bool_default_send <no>
          mat_font_id <arial>
          mat_font_size <9>
          mat_font_style <bold>
        man_end_object
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hfe>
      mat_vertical_spacing <4>
      man_start_object <trigger, "">
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_title <"   Send Now  ">
        mat_vertical_spacing <2>
        mat_bool_default <yes>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream
              de_start_extraction
              man_set_context_relative <3>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-332>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              man_set_context_relative <1>
              idb_start_obj <"b">
              idb_atr_globalid <20-0-118>
              de_get_data_value
              uni_use_last_atom_value <idb_append_data>
              idb_end_obj
              man_end_context
              de_end_extraction
              man_close
              man_update_display
              mip_action_command <0fx>
            uni_end_stream
            >
        man_start_sibling <org_group, "">
          mat_orientation <hff>
          man_start_object <trigger, "">
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_title <"   Mail Folders  ">
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream
                  de_start_extraction
                  man_set_context_relative <3>
                  idb_start_obj <"b">
                  idb_atr_globalid <20-0-332>
                  de_get_data_value
                  uni_use_last_atom_value <idb_append_data>
                  idb_end_obj
                  man_end_context
                  de_end_extraction
                  man_close_update
                  uni_invoke_no_context <32-4635>
                uni_end_stream
                >
            man_start_sibling <trigger, "">
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_size <8>
              mat_title <"   Send Later   ">
              mat_font_id <arial>
              act_replace_select_action
                  <
                  uni_start_stream
                    de_start_extraction
                    man_set_context_relative <3>
                    idb_start_obj <"b">
                    idb_atr_globalid <20-0-332>
                    de_get_data_value
                    uni_use_last_atom_value <idb_append_data>
                    idb_end_obj
                    de_end_extraction
                    man_end_context
                    man_close_update
                  uni_end_stream
                  >
              man_end_object
            man_end_object
          man_end_object
          man_update_display
          man_set_context_relative <1>
          act_get_db_value <14x, 00x, 00x, 76x>
          uni_use_last_atom_value <mat_value>
          man_end_context
          man_update_display
          man_set_context_relative <3>
          mat_bool_draw_focus <yes>
          man_place_cursor <3>
          man_update_display
          man_end_context
          uni_wait_off
        uni_end_stream <00x>
