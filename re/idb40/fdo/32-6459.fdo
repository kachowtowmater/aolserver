uni_start_stream <00x>
  man_start_object <ind_group, "AOL Setup">
    mat_style_id <32-6459>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <org_group, "">
      mat_orientation <hlc>
      man_start_object <ornament, "">
        mat_art_id <1-1-22358>
        mat_bool_disabled <yes>
      man_start_sibling <org_group, "">
        mat_orientation <vlc>
        man_start_object <ornament, "No Locations Set Up">
          mat_size <25, 1, 128>
          mat_font_id <arial>
          mat_font_size <14>
          mat_font_style <bold>
        man_start_sibling <org_group, "">
          mat_orientation <vff>
          mat_precise_width <440>
          mat_precise_height <2>
          mat_color_face <1, 1, 1>
          mat_bool_background_flood <yes>
          mat_bool_precise <yes>
        man_end_object
      man_end_object
    man_start_sibling <view, "">
      rich_manage
      rich_set_static
      mat_size <45, 6, 2048>
      mat_horizontal_spacing <2>
      mat_bool_vertical_scroll <no>
      mat_bool_resize_vertical <no>
      mat_bool_resize_horizontal <no>
      mat_bool_exportable <no>
      man_append_data <" \x7fYou have no locations set up to connect to the AOL service.  You need to set up at least one location to connect. \x7f\x7fWhat do you want to do?">
    man_start_sibling <sss_list, "">
      mat_orientation <vff>
      mat_relative_tag <1>
      man_start_object <trigger, "Create a location with automatic setup (recommended).">
        mat_bool_default_send <no>
        mat_value <1>
      man_start_sibling <trigger, "Create a location without help (expert or TCP/IP).">
        mat_bool_default_send <no>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "">
        mat_trigger_style <plain_picture>
        mat_bool_hidden <yes>
        mat_art_id <1-1-31171>
        mat_command_key <98x, 00x>
        act_replace_select_action
            <
            uni_start_stream
              man_close_update
              man_obj_stack_pop <1>
              uni_use_last_atom_value <uni_invoke_no_context>
            uni_end_stream
            >
        man_start_sibling <org_group, "">
          mat_orientation <hcc>
          man_start_object <trigger, "Cancel">
            mat_title_width <6>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_sis <arial, 8, normal>
            act_replace_select_action
                <
                uni_start_stream
                  man_close_update
                  man_preset_gid <32-221>
                  if_last_return_true_then <1, 2>
                  mat_bool_invisible <no>
                  man_make_focus
                  man_update_display
                  man_end_context
                  uni_sync_skip <1>
                  if_offline_then <2>
                  uni_invoke_no_context <32-221>
                  uni_sync_skip <2>
                uni_end_stream
                >
            man_end_object
          man_start_sibling <trigger, "">
            mat_relative_tag <81>
            mat_trigger_style <plain_picture>
            if_newuser_then <2, 3>
            mat_art_id <1-3-398>
            uni_sync_skip <2>
            mat_art_id <1-1-14785>
            uni_sync_skip <3>
            mat_bool_default <yes>
            mat_font_id <arial>
            mat_font_size <10>
            mat_command_key <99x, 00x>
            act_replace_select_action
                <
                uni_start_stream
                  man_obj_stack_pop <2>
                  de_start_extraction <0>
                  man_set_context_relative <1>
                  de_get_data_value
                  var_number_set_from_atom <D>
                  man_end_context
                  de_end_extraction
                  var_number_set <B, 1>
                  var_number_save <B, 2244739072>
                  man_obj_stack_push <32-6459>
                  man_close_update
                  man_preset_gid <32-221>
                  if_last_return_true_then <3>
                  mat_bool_invisible <yes>
                  man_update_display
                  man_end_context
                  uni_sync_skip <3>
                  var_number_get <D>
                  var_number_set_from_atom <A>
                  if_numa_eq_one_then <1>
                  dice_access_search_form
                uni_abort_stream
                uni_sync_skip <1>
                uni_invoke_no_context <41-28374>
              uni_end_stream
              >
          man_end_object
        man_end_object
        man_update_display
        man_set_context_relative <81>
        man_make_focus
        man_update_display
        man_end_context
        uni_wait_off
      uni_end_stream <00x>
