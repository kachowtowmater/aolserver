uni_start_stream <00x>
  man_start_object <ind_group, "Connectivity Summary">
    mat_object_id <41-31686>
    mat_style_id <41-31686>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <org_group, "">
      mat_orientation <hlc>
      man_start_object <ornament, "">
        mat_art_id <1-1-22358>
        mat_bool_disabled <yes>
      man_start_sibling <org_group, "">
        mat_orientation <vlc>
        man_start_object <ornament, "Connectivity Summary">
          mat_size <25, 1, 128>
          mat_font_id <arial>
          mat_font_size <14>
          mat_font_style <bold>
        man_start_sibling <org_group, "">
          mat_orientation <vff>
          mat_precise_width <400>
          mat_precise_height <2>
          mat_color_face <1, 1, 1>
          mat_bool_background_flood <yes>
          mat_bool_precise <yes>
        man_end_object
      man_end_object
    man_start_sibling <view, "">
      rich_manage
      mat_size <47, 14>
      mat_relative_tag <1>
      rich_bool_read_only <yes>
      mat_bool_writeable <yes>
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "OK">
        mat_title_width <8>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_sis <arial, 8, normal>
        mat_bool_default <yes>
        act_replace_select_action
            <
            uni_start_stream <00x>
              man_close_update
            uni_end_stream <00x>
            >
        man_start_sibling <trigger, "Print">
          mat_title_width <8>
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_sis <arial, 8, normal>
          act_replace_select_action
              <
              uni_start_stream
                fm_start
                fm_broadcast <09x>
                fm_handle_error <display_msg | terminate>
                fm_end
                man_close_update <41-31686>
              uni_end_stream
              >
          man_start_sibling <trigger, "">
            mat_title_width <8>
            mat_bool_hidden <yes>
            mat_bool_default <yes>
          man_end_object
        man_end_object
        man_update_display
        uni_wait_off
      uni_end_stream <00x>
