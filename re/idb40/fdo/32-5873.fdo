uni_start_stream <00x>
  man_start_object <ind_group, "America Online">
    mat_object_id <32-5873>
    mat_style_id <32-5873>
    mat_orientation <vff>
    mat_precise_width <229>
    mat_precise_height <204>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_precise <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_precise_x <5>
      mat_precise_y <8>
      mat_precise_width <214>
      mat_precise_height <35>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"You have selected a Favorite Place. Which of the following would you like to do?">
    man_start_sibling <org_group, "">
      mat_orientation <vcf>
      mat_precise_y <50>
      mat_precise_width <220>
      mat_precise_height <150>
      man_start_object <trigger, "Add to Favorites">
        mat_precise_x <45>
        mat_precise_y <58>
        mat_precise_width <135>
        mat_precise_height <23>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream
              mat_fp_save_to_fp
              man_close_update
            uni_end_stream
            >
        man_start_sibling <trigger, "Insert in Instant Message">
          mat_precise_x <45>
          mat_precise_y <91>
          mat_precise_width <135>
          mat_precise_height <23>
          mat_relative_tag <10>
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_size <8>
          mat_bool_active_online <yes>
          mat_bool_disabled <yes>
          mat_font_id <arial>
          act_replace_select_action
              <
              uni_start_stream
                mat_fp_send_im
              uni_end_stream
              >
          man_start_sibling <trigger, "Insert in Mail">
            mat_precise_x <45>
            mat_precise_y <124>
            mat_precise_width <135>
            mat_precise_height <23>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream
                  mat_fp_compose_mail
                uni_end_stream
                >
            man_start_sibling <trigger, "Cancel">
              mat_precise_x <149>
              mat_precise_y <176>
              mat_precise_width <70>
              mat_precise_height <23>
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_size <8>
              mat_font_id <arial>
              act_replace_select_action
                  <
                  uni_start_stream
                    man_close_update
                  uni_end_stream
                  >
              man_end_object
            man_end_object
            man_update_display
            man_set_context_relative <10>
            if_offline_then <1>
            mat_bool_disabled <yes>
            uni_sync_skip <1>
            if_online_then <2>
            mat_bool_disabled <no>
            uni_sync_skip <2>
            man_update_display
            man_end_context
            uni_wait_off
          uni_end_stream <00x>
