uni_start_stream <00x>
  man_start_object <ind_group, "Download Files">
    mat_object_id <41-27430>
    mat_style_id <41-27430>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_size <43, 6>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"You have one or more files waiting to be downloaded to your computer.  To download the file(s) and automatically sign off afterward, click Download Now.  To see the file(s), click Download Manager.  To sign off now without downloading the file(s), click Sign Off.">
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "">
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_title <"  Download Now  ">
        mat_horizontal_spacing <4>
        mat_vertical_spacing <0>
        mat_bool_default <yes>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream
              xfer_batch_download
            uni_end_stream
            >
        man_start_sibling <trigger, "">
          mat_color_face <0, 109, 170>
          mat_color_text <255, 255, 255>
          mat_color_top_edge <145, 182, 255>
          mat_color_bottom_edge <1, 1, 1>
          mat_trigger_style <rectangle>
          mat_font_size <8>
          mat_title <"  Download Manager  ">
          mat_horizontal_spacing <4>
          mat_vertical_spacing <0>
          mat_font_id <arial>
          act_replace_select_action
              <
              uni_start_stream <00x>
                uni_wait_on
                man_close_update
                man_preset_gid <32-4624>
                if_last_return_true_then <1, 2>
                man_make_focus
                man_update_display
                uni_sync_skip <1>
                uni_invoke_no_context <32-4624>
                uni_sync_skip <2>
              uni_end_stream <00x>
              >
          man_start_sibling <trigger, "">
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_title <"   Sign Off    ">
            mat_horizontal_spacing <0>
            mat_vertical_spacing <0>
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream
                  async_signoff
                uni_end_stream
                >
            man_end_object
          man_end_object
          man_update_display
          uni_wait_off
        uni_end_stream <00x>
