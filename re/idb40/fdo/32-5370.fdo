uni_start_stream <00x>
  man_start_object <ind_group, "Tool Versions">
    mat_object_id <32-5370>
    mat_style_id <32-5370>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <dss_list, "Module Name\tVersion">
      mat_orientation <vff>
      mat_size <60, 10>
      mat_relative_tag <200>
      mat_ruler <42, 52>
    man_start_sibling <org_group, "">
      mat_orientation <hcf>
      man_start_object <trigger, "OK">
        mat_title_width <9>
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_bool_default <yes>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream <00x>
              man_close_update
            uni_end_stream <00x>
            >
        man_end_object
      man_end_object
      man_update_display
      uni_wait_off
    uni_end_stream <00x>
