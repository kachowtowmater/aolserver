uni_start_stream
  man_start_object <dss_list, "">
    mat_relative_tag <120>
    mat_shortcut_key <"P">
    mat_bool_popup_menu <yes>
    man_start_object <trigger, "AOL Today">
      mat_shortcut_key <"A">
      act_replace_select_action
          <
          uni_start_stream
            if_offline_then <1>
            uni_wait_off
          uni_abort_stream
          uni_sync_skip <1>
        sm_send_f1 <32-6468>
        >
    man_start_sibling <ornament, "">
    man_start_sibling <trigger, "News">
      mat_shortcut_key <"N">
