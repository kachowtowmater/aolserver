uni_start_stream <00x>
  man_start_object <ind_group, "AOL Setup">
    mat_style_id <32-6072>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <org_group, "">
      mat_orientation <hlc>
      man_start_object <ornament, "">
        mat_art_id <1-1-22358>
        mat_bool_disabled <yes>
      man_start_sibling <org_group, "">
        mat_orientation <vlc>
        man_start_object <ornament, "Add Numbers (Connections)">
          mat_size <25, 1, 128>
          mat_font_id <arial>
          mat_font_size <14>
          mat_font_style <bold>
          uni_start_typed_data <latin1>
          man_append_data
        man_start_sibling <org_group, "">
          mat_orientation <vff>
          mat_precise_width <440>
          mat_precise_height <2>
          mat_color_face <1, 1, 1>
          mat_bool_background_flood <yes>
          mat_bool_precise <yes>
        man_end_object
      man_end_object
    man_start_sibling <ornament, "">
      mat_size <55, 5, 2048>
      mat_horizontal_spacing <2>
      uni_next_atom_typed <ascii>
      man_append_data <"You can't yet use this location to connect to the AOL service because no numbers (connections) are set up for it.\x7f\x7fWhat do you want to do?">
    man_start_sibling <sss_list, "">
      mat_orientation <vff>
      mat_relative_tag <1>
      uni_next_atom_typed <ascii>
      man_start_object <trigger, "Go to automatic search for access numbers (recommended).">
        mat_bool_default_send <no>
        mat_value <1>
        uni_next_atom_typed <ascii>
      man_start_sibling <trigger, "Go to custom connection setup (expert or TCP/IP setup).">
        mat_bool_default_send <no>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "">
        mat_trigger_style <plain_picture>
        mat_bool_hidden <yes>
        mat_art_id <1-1-31171>
        mat_command_key <98x, 00x>
        act_replace_select_action
            <
            uni_start_stream
              man_close_update
              man_obj_stack_pop <1>
              uni_use_last_atom_value <uni_invoke_no_context>
            uni_end_stream
            >
        man_start_sibling <org_group, "">
          mat_orientation <hcc>
          uni_next_atom_typed <ascii>
          man_start_object <trigger, "Cancel">
            mat_title_width <6>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_sis <arial, 8, normal>
            act_replace_select_action
                <
                uni_start_stream
                  man_close_update
                  man_preset_gid <32-221>
                  if_last_return_true_then <1, 2>
                  mat_bool_invisible <no>
                  man_update_display
                  man_end_context
                  uni_sync_skip <1>
                  if_offline_then <2>
                  uni_invoke_no_context <32-221>
                  uni_sync_skip <2>
                uni_end_stream
                >
            man_start_sibling <trigger, "">
              mat_title_width <6>
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_sis <arial, 8, normal>
              mat_bool_invisible <yes>
              act_replace_select_action
                  <
                  uni_start_stream_wait_on
                    uni_next_atom_typed <ascii>
                    async_exec_context_help <61x, 63x, 63x, 65x, 73x, 73x, 20x, 6ex, 75x, 6dx, 62x, 65x, 72x, 73x>
                  uni_wait_off_end_stream
                  >
              man_end_object
            man_start_sibling <trigger, "">
              mat_trigger_style <plain_picture>
              if_newuser_then <2, 3>
              mat_art_id <1-3-398>
              uni_sync_skip <2>
              mat_art_id <1-1-14785>
              uni_sync_skip <3>
              mat_bool_default <yes>
              mat_font_id <arial>
              mat_font_size <10>
              mat_command_key <99x, 00x>
              act_replace_select_action
                  <
                  uni_start_stream
                    man_obj_stack_pop <2>
                    de_start_extraction <0>
                    man_set_context_relative <1>
                    de_get_data_value
                    var_number_set_from_atom <A>
                    man_end_context
                    de_end_extraction
                    if_numa_eq_one_then <1>
                    var_number_set <A, 1>
                    var_number_save <A, 2244739072>
                    man_obj_stack_push <32-6072>
                    man_close_update
                    man_preset_gid <32-221>
                    if_last_return_true_then <3>
                    mat_bool_invisible <yes>
                    man_update_display
                    man_end_context
                    uni_sync_skip <3>
                    uni_invoke_no_context <41-20994>
                  uni_abort_stream
                  uni_sync_skip <1>
                  man_close_update
                  man_preset_gid <32-221>
                  if_last_return_true_then <4, 5>
                  mat_bool_invisible <no>
                  man_update_display
                  man_end_context
                  uni_sync_skip <4>
                  if_offline_then <5>
                  uni_invoke_no_context <32-221>
                  uni_sync_skip <5>
                  uni_invoke_no_context <40-50039>
                  man_update_display
                  man_get_top_window
                  uni_use_last_atom_value <man_set_context_globalid>
                  man_set_context_relative <2>
                  act_do_action <select>
                  man_end_context
                  man_end_context
                  man_update_display
                uni_end_stream
                >
            man_end_object
          man_end_object
          man_update_display
          uni_end_typed_data
          uni_wait_off
        uni_end_stream <00x>
