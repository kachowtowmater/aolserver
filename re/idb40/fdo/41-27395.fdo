uni_start_stream <00x>
  man_start_object <ind_group, "Send Later">
    mat_object_id <41-27395>
    mat_style_id <41-27395>
    mat_orientation <vff>
    mat_color_face <255, 251, 240>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_background_flood <yes>
    man_start_object <ornament, "">
      mat_size <43, 6>
      mat_font_size <8>
      mat_font_id <arial>
      man_append_data <"Your mail has been placed in the \"Mail Waiting to be Sent\" folder of your Personal Filing Cabinet.  To see your outgoing mail, click \"Mail Waiting to be Sent\".  To schedule a time to automatically send your Mail Waiting to be Sent, click \"Auto AOL\".">
    man_start_sibling <org_group, "">
      mat_orientation <hff>
      man_start_object <trigger, "">
        mat_color_face <0, 109, 170>
        mat_color_text <255, 255, 255>
        mat_color_top_edge <145, 182, 255>
        mat_color_bottom_edge <1, 1, 1>
        mat_trigger_style <rectangle>
        mat_font_size <8>
        mat_title <"       OK       ">
        mat_vertical_spacing <0>
        mat_font_id <arial>
        act_replace_select_action
            <
            uni_start_stream <00x>
              man_close_update
            uni_end_stream <00x>
            >
        man_start_sibling <org_group, "">
          mat_orientation <hff>
          man_start_object <trigger, "">
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_size <8>
            mat_title <"   Mail Waiting to be Sent   ">
            mat_horizontal_spacing <4>
            mat_vertical_spacing <0>
            mat_font_id <arial>
            act_replace_select_action
                <
                uni_start_stream
                  man_close_update
                  uni_invoke_local <32-4635>
                uni_end_stream
                >
            man_start_sibling <trigger, "">
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_size <8>
              mat_title <"    Auto AOL   ">
              mat_horizontal_spacing <0>
              mat_vertical_spacing <0>
              mat_font_id <arial>
              act_replace_select_action
                  <
                  uni_start_stream
                    man_close_update
                    uni_invoke_local <32-2506>
                  uni_end_stream
                  >
              man_end_object
            man_end_object
          man_end_object
          man_update_display
          uni_wait_off
        uni_end_stream <00x>
