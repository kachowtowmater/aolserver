uni_start_stream <00x>
  act_set_newuser_flag <01x>
  man_start_object <ind_group, "AOL Setup">
    mat_object_id <41-13415>
    mat_style_id <41-13415>
    mat_orientation <hff>
    mat_color_face <255, 251, 240>
    mat_bool_background_flood <yes>
    mat_position <center_center>
    mat_bool_resize_vertical <no>
    mat_bool_modal <yes>
    mat_bool_background_flood <yes>
    man_start_object <org_group, "">
      mat_orientation <vfc>
      man_start_object <ornament, "">
        mat_art_id <1-1-46515>
        mat_bool_disabled <yes>
      man_end_object
    man_start_sibling <org_group, "">
      mat_orientation <vff>
      man_start_object <org_group, "">
        mat_orientation <vlc>
        man_start_object <ornament, "">
          mat_size <33, 1, 35>
          mat_font_id <arial>
          mat_font_size <14>
          mat_font_style <bold>
          man_append_data <"Connecting to America Online">
        man_start_sibling <org_group, "">
          mat_orientation <vff>
          mat_precise_width <440>
          mat_precise_height <2>
          mat_color_face <1, 1, 1>
          mat_bool_background_flood <yes>
          mat_bool_precise <yes>
        man_end_object
      man_start_sibling <view, "">
        rich_manage
        rich_set_static
        mat_size <52, 10>
        mat_bool_vertical_scroll <no>
        mat_bool_resize_vertical <no>
        mat_bool_resize_horizontal <no>
        mat_bool_exportable <no>
        man_append_data <"We'll now help you set up the America Online service to work with your computer.\x7f\x7fPlease make sure your computer's modem is connected to your phone line.  If you're not sure how to do this, consult your computer's instruction manual.  If you have an external modem, make sure it's turned on.\x7f\x7fAlso, make sure no one else is using the phone right now.\x7f\x7fBEGIN Quick & Easy setup by clicking <B>NEXT</B>.">
      man_start_sibling <org_group, "">
        mat_orientation <hcc>
        mat_bool_invisible <yes>
      man_start_sibling <org_group, "">
        mat_orientation <hff>
        man_start_object <org_group, "">
          mat_orientation <hcc>
          man_start_object <trigger, "Cancel">
            mat_title_width <6>
            mat_relative_tag <82>
            mat_color_face <0, 109, 170>
            mat_color_text <255, 255, 255>
            mat_color_top_edge <145, 182, 255>
            mat_color_bottom_edge <1, 1, 1>
            mat_trigger_style <rectangle>
            mat_font_sis <arial, 8, normal>
            act_replace_select_action
                <
                uni_start_stream
                  uni_invoke_no_context <41-27653>
                uni_end_stream
                >
            man_start_sibling <trigger, "Expert Setup">
              mat_title_width <10>
              mat_relative_tag <83>
              mat_color_face <0, 109, 170>
              mat_color_text <255, 255, 255>
              mat_color_top_edge <145, 182, 255>
              mat_color_bottom_edge <1, 1, 1>
              mat_trigger_style <rectangle>
              mat_font_sis <arial, 8, normal>
              act_replace_select_action
                  <
                  uni_start_stream
                    man_obj_stack_pop <2>
                    man_obj_stack_push
                    var_number_set <A, 1>
                    var_number_save <A, 2244739072>
                    var_number_set <A, 0>
                    var_number_save <A, 2244739586>
                    man_preset_gid <32-221>
                    if_last_return_true_then <3>
                    mat_bool_invisible <yes>
                    man_update_display
                    man_end_context
                    uni_sync_skip <3>
                    man_close_update
                    man_end_context
                    uni_invoke_no_context <32-5858>
                  uni_end_stream
                  >
              man_end_object
            man_start_sibling <trigger, "">
              mat_relative_tag <81>
              mat_trigger_style <plain_picture>
              mat_context_help <"Click here to continue on\x7fto the next setup screen.">
              if_newuser_then <2, 3>
              mat_art_id <1-3-398>
              uni_sync_skip <2>
              mat_art_id <1-1-14785>
              uni_sync_skip <3>
              mat_bool_default <yes>
              mat_font_id <arial>
              mat_font_size <10>
              mat_command_key <99x, 00x>
              act_replace_select_action
                  <
                  uni_start_stream
                    man_obj_stack_pop <2>
                    man_obj_stack_push
                    var_number_set <A, 1>
                    var_number_save <A, 2244739072>
                    var_number_set <A, 0>
                    var_number_save <A, 2244739586>
                    man_preset_gid <32-221>
                    if_last_return_true_then <3>
                    mat_bool_invisible <yes>
                    man_update_display
                    man_end_context
                    uni_sync_skip <3>
                    man_close_update
                    man_end_context
                    uni_invoke_no_context <32-5574>
                  uni_end_stream
                  >
              man_end_object
            man_end_object
          man_end_object
          man_update_display
          man_set_context_relative <81>
          man_make_focus
          man_update_display
          man_end_context
          uni_wait_off
        uni_end_stream <00x>
