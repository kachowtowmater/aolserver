          man_start_object <trigger, "">
            mat_title <"Add to New Location...">
          man_end_object
          morg_obj_end_context
          man_end_context
        uni_end_stream
        >
      act_do_action <gain_focus>
      dice_update_locality
      uni_save_result
      if_last_return_true_then <20>
      man_set_context_relative <1>
      uni_get_result
