            mat_color_face <1, 1, 1>
            mat_bool_background_flood <yes>
          man_end_object
        man_end_object
      man_end_object
    man_end_object
    man_start_object <org_group, "">
      mat_orientation <hee>
      man_start_object <ornament, "">
        mat_width <1>
      man_end_object
      man_start_object <edit_view, "">
        mat_relative_tag <1>
        mat_title <"Name:">
        mat_title_pos <above | top_or_left>
        mat_size <27, 1>
        mat_capacity <79>
        mat_validation <128>
        mat_field_script <any>
      man_end_object
      man_start_object <ornament, "">
        mat_width <1>
      man_end_object
      man_start_object <dss_list, "">
        mat_relative_tag <4>
        mat_title <"Will be added to this location:">
        mat_title_pos <above | top_or_left>
        mat_size <23, 1>
        mat_context_help <"Pick which location you want\x7fthis number (connection) added to.">
      man_end_object
      man_start_object <ornament, "">
        mat_width <1>
      man_end_object
    man_end_object
    man_start_object <org_group, "">
      mat_orientation <hft>
      man_start_object <dss_list, "">
        mat_relative_tag <2>
        mat_size <42, 1>
        mat_title_pos <left | center | 4>
        mat_title <"   Connect using:">
        mat_context_help <"Select how this number (connection) will connect.">
        act_replace_select_action
            <
            uni_start_stream
              man_set_context_relative <2>
              de_start_extraction <0>
              de_set_data_type <index>
              de_get_data_value
              uni_use_last_atom_value <dice_set_context_device>
              dice_get_obj_info <13>
              var_number_set_from_atom <A>
              dice_end_context
              de_set_data_type <text>
              de_get_data_pointer
              var_string_set_from_atom <A>
              man_change_context_relative <90>
              de_get_data_pointer
              var_string_set_from_atom <B>
              var_string_get <A>
              uni_use_last_atom_string <man_replace_data>
              man_update_display
              if_strb_neq_null_then <5, 6>
              man_change_context_relative <2>
              var_string_get <B>
              uni_use_last_atom_string <man_get_index_by_title>
              uni_use_last_atom_value <dice_set_context_device>
              dice_get_obj_info <13>
              var_number_set_from_atom <B>
              dice_end_context
              uni_sync_skip <5>
              var_number_set <B, 0>
              uni_sync_skip <6>
              de_end_extraction
              man_end_context
              if_stra_eq_strb_then <3>
            uni_abort_stream
            uni_sync_skip <3>
            man_set_context_relative <15>
            de_start_extraction <0>
            de_set_data_type <text>
            de_get_data_pointer
            var_string_set_from_atom <B>
            de_end_extraction
            man_end_context
            var_number_set <D, 0>
            if_strb_neq_null_then <4>
            var_number_set <D, 1>
            if_numa_eq_numb_then <4>
          uni_abort_stream
          uni_sync_skip <4>
          var_number_get <A>
          uni_use_last_atom_value <dice_set_context_tool>
          dice_send_message <3>
          dice_end_context
          man_update_display
        uni_end_stream
        >
    man_end_object
  man_end_object
  man_start_object <org_group, "">
