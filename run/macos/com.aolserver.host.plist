<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- aolserver host as a login service on macOS.
     Edit REPO below, then:  cp com.aolserver.host.plist ~/Library/LaunchAgents/ &&
     launchctl load ~/Library/LaunchAgents/com.aolserver.host.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aolserver.host</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>python3</string>
    <string>REPO/start.py</string>
  </array>
  <key>WorkingDirectory</key><string>REPO</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>REPO/run/server.log</string>
  <key>StandardErrorPath</key><string>REPO/run/server.log</string>
</dict>
</plist>
